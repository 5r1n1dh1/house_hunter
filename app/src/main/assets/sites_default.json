    "pagination": {
      "maxPages": 2
    },
    "rateLimitSeconds": 8,
    "enabled": true,
    "requiresManual": false,
    "engine": "http",
    "searchUrlFallback": "https://www.99acres.com/property-for-rent-in-bangalore-ffid",
    "note": "City-wide page (no locality URL); results are narrowed to your locality on device. Needs browser-shaped request headers - it answers 403 without them."
  },
