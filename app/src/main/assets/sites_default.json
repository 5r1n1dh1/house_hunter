      "maxPages": 1
    },
    "rateLimitSeconds": 8,
    "enabled": true,
    "requiresManual": false,
    "note": "Primary source. Prices come from the schema.org JSON-LD each card embeds. The city slug is hardcoded to 'bangalore'; enable other sites for wider coverage.",
    "searchUrlFallback": "https://www.magicbricks.com/property-for-rent-in-sahakara-nagar-bangalore-pppfr"
  },
