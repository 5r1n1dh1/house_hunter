[
  {
    "id": "nobroker",
    "name": "NoBroker",
    "baseUrl": "https://www.nobroker.in",
    "searchUrlTemplate": "https://www.nobroker.in/properties-for-rent-in-{LOCALITY_SLUG}-bangalore-page-{PAGE}",
    "mode": "json",
    "jsonAnchorKey": "rent",
    "jsonFieldMap": {
      "rent": "rent",
      "title": "propertyTitle",
      "type": "type",
      "area": "propertySize",
      "detailUrl": "detailUrl",
      "image": "originalImageUrl",
      "furnishing": "furnishingDesc",
      "locality": "localityTruncated",
      "owner": "ownerName",
      "builder": "builderName"
    },
    "selectors": {
      "listContainer": "div[unused]",
      "title": "h2",
      "price": ""
    },
    "pagination": {
      "maxPages": 3
    },
    "rateLimitSeconds": 6,
    "enabled": true,
    "requiresManual": false,
    "note": "Listings are an embedded JSON array; the visible price is rendered by JavaScript, so the app reads the JSON. City slug is 'bangalore'.",
    "searchUrlFallback": "https://www.nobroker.in/flats-for-rent-in-bangalore_bangalore"
  },
  {
    "id": "magicbricks",
    "name": "MagicBricks",
    "baseUrl": "https://www.magicbricks.com",
    "searchUrlTemplate": "https://www.magicbricks.com/property-for-rent-in-{LOCALITY_SLUG}-bangalore-pppfr",
    "selectors": {
      "listContainer": "div.mb-srp__list",
      "title": "h2.mb-srp__card--title",
      "price": "div.mb-srp__card__price--amount",
      "areaSqft": "[data-summary='carpet-area'] div.mb-srp__card__summary--value",
      "furnishing": "[data-summary='furnishing'] div.mb-srp__card__summary--value",
      "imageUrl": "img.mb-srp__card__photo__fig--graphic",
      "postedDate": "div.mb-srp__card__photo__fig--post",
      "ownerTag": "div.mb-srp__card__ads--name"
    },
    "pagination": {
      "maxPages": 1
    },
    "rateLimitSeconds": 8,
    "enabled": true,
    "requiresManual": false,
    "note": "Primary source. Prices come from the schema.org JSON-LD each card embeds. The city slug is hardcoded to 'bangalore'; enable other sites for wider coverage.",
    "searchUrlFallback": "https://www.magicbricks.com/property-for-rent-in-sahakara-nagar-bangalore-pppfr"
  },
  {
    "id": "99acres",
    "name": "99acres",
    "baseUrl": "https://www.99acres.com",
    "searchUrlTemplate": "https://www.99acres.com/property-for-rent-in-{CITY_NAME}-ffid",
    "mode": "cards",
    "selectors": {
      "listContainer": "div[class*='tupleNew__tupleWrap']",
      "title": "h2[class*='tupleNew__propType']",
      "price": "div[class*='tupleNew__priceValWrap']",
      "areaSqft": "div[class*='tupleNew__areaType']",
      "detailUrl": "a[href*='spid-']",
      "ownerTag": "div[class*='tupleNew__pbL1']",
      "ownerName": "div[class*='tupleNew__pbL2']"
    },
    "localityFilter": true,
    "pagination": {
      "maxPages": 2
    },
    "rateLimitSeconds": 8,
    "enabled": true,
    "requiresManual": false,
    "engine": "http",
    "searchUrlFallback": "https://www.99acres.com/property-for-rent-in-bangalore-ffid",
    "note": "City-wide page (no locality URL); results are narrowed to your locality on device. Needs browser-shaped request headers - it answers 403 without them. Photos are lazy-loaded and absent from the server markup, so these cards show a placeholder image."
  },
  {
