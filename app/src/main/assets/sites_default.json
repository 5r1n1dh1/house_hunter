  {
    "id": "razorent",
    "name": "Razorent",
    "baseUrl": "https://razorent.com",
    "searchUrlTemplate": "https://api.razorent.com/properties?city={CITY_NAME}&limit=50",
    "mode": "json",
    "jsonAnchorKey": "rent",
    "jsonFieldMap": {
      "rent": "rent",
      "title": "title",
      "locality": "locality",
      "area": "area",
      "furnishing": "furnishingType",
      "propertyType": "propertyType",
      "bhk": "bhk",
      "lat": "latitude",
      "lng": "longitude",
      "image": "heroImageUrl",
      "owner": "owner.name",
      "detailUrl": "https://razorent.com/property/{id}",
      "deposit": "securityDeposit",
      "maintenance": "maintenanceCharges"
    },
    "selectors": {
      "listContainer": "div",
      "title": "h1",
      "price": "span"
    },
    "pagination": {
      "maxPages": 2
    },
    "rateLimitSeconds": 6,
    "enabled": true,
    "requiresManual": false,
    "engine": "http",
    "note": "Reads Razorent's own public JSON API (the same one their site calls; no key, no login). Owner-posted listings with rent, BHK, photos and exact coordinates. Sales listings carry no rent and drop out automatically."
  },
